{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/download/(.*)\\.dmg",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-diskimage" },
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
